# Copy to .env before running `docker compose up -d --build`
#   cp .env.docker.example .env     (Windows: copy .env.docker.example .env)

# Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Encrypts the TOTP shared secret at rest (AES-256-GCM).
APP_ENCRYPTION_KEY=

# ---- Database ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-too
POSTGRES_DB=nimbus
DB_PORT=5432

# ---- App ----
APP_PORT=4000
PUBLIC_URL=http://localhost:4000
# Must match PUBLIC_URL so the browser origin is allowed by CORS.
CLIENT_ORIGINS=http://localhost:4000
LOG_LEVEL=info

# ---- Email (optional) ----
# Leave empty and emails are written to the log instead of being sent.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=WKSL <no-reply@nimbus.local>

# ---- Background jobs ----
ENABLE_JOBS=true
JOB_INTERVAL_MINUTES=30
