# Copy to .env before running `docker compose up -d --build`
#   cp .env.docker.example .env     (Windows: copy .env.docker.example .env)

# Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Encrypts the TOTP shared secret at rest (AES-256-GCM).
APP_ENCRYPTION_KEY=

# ---- Database ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-too
POSTGRES_DB=nimbus
DB_PORT=5432

# ---- App ----
APP_PORT=4000
# The public origin — used in email links, meta tags and CORS. No trailing slash.
# The app lives on a subdomain; the apex (wksl.site) belongs to the GSO site, so
# never point PUBLIC_URL or a DNS record at it.
PUBLIC_URL=https://app.wksl.site
# Must cover every origin the browser can actually be served from. A www host
# counts separately, otherwise CORS rejects the requests it makes.
CLIENT_ORIGINS=https://app.wksl.site
# Required. Without it `req.ip` is whatever the last proxy was — the Caddy
# container — so the rate limiter would lump all traffic into a single bucket.
TRUST_PROXY=true
# 1 = one local proxy (Caddy on the VM itself).
# 2 = Cloudflare's proxy sits in front of that — use this behind Cloudflare or
# the rate limiter counts whole traffic against the Cloudflare edge IP.
TRUST_PROXY_HOPS=2
LOG_LEVEL=info

# Emit HSTS includeSubDomains + preload. Leave off on a subdomain — see the note
# in server/.env.example.
HSTS_INCLUDE_SUBDOMAINS=false

# ---- Email (optional) ----
# Leave empty and emails are written to the log instead of being sent.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=WKSL <no-reply@nimbus.local>

# ---- Google sign-in (optional) ----
# Create a "Web application" OAuth client and register
# <PUBLIC_URL>/api/auth/google/callback as an authorised redirect URI.
# Empty means the button is hidden and the endpoints answer 503.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT=

# ---- Background jobs ----
ENABLE_JOBS=true
JOB_INTERVAL_MINUTES=30

# ---- Chunked (large-file) uploads ----
# Files bigger than MAX_UPLOAD_MB are sent in 16 MB chunks and reassembled by
# the server, so 1 GB files work without huge request bodies.
UPLOAD_CHUNK_MB=16
MAX_CHUNKED_UPLOAD_MB=1024

# ---- Web push ----
# npx web-push generate-vapid-keys; both blank disables the feature.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Reference categories that are missing are added on every boot so a fresh
# database is usable. Set to false only if you manage the taxonomy yourself.
# SEED_CATEGORIES=true
