node_modules/
dist/
build/
coverage/
*.tsbuildinfo

# Real credentials never get committed. Only the `*.example` templates are
# tracked, so the negations below re-admit just those.
.env
.env.local
.env.*
!.env.example
!.env.docker.example
!.env.production.example

server/uploads/*
!server/uploads/.gitkeep
!server/uploads/.gitignore

backups/
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# Dev server helper — local process state, never shared.
.dev-server.pid
.dev-server.log
.prod-server.pid
.prod-server.log

# CI is not tracked right now: the GitHub token available on this machine has
# no `workflow` scope, and GitHub refuses any push that touches this path.
# Re-enable it (and drop this line) once a token with `workflow` is in use.
.github/workflows/

.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json