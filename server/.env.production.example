# ---- Server ----
NODE_ENV=production
PORT=4000
CLIENT_ORIGINS=http://localhost:4000
PUBLIC_URL=http://localhost:4000
LOG_LEVEL=info
TRUST_PROXY=true

# ---- Database ----
# Production keeps its own database; `nimbus` is left for local testing.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/wksl_prod?schema=public"

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ---- Security policy ----
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCK_MINUTES=15
PASSWORD_RESET_TTL_MINUTES=60
EMAIL_VERIFY_TTL_HOURS=48
EMAIL_VERIFICATION_REQUIRED=true
TWO_FACTOR_ISSUER=WKSL

# Failed auth attempts per IP per window. Only failures count.
AUTH_LIMIT_MAX=20
AUTH_LIMIT_WINDOW_MINUTES=15

# ---- Email (SMTP) ----
# Leave unset locally: emails are printed to the log and their links returned
# by the API, so every flow stays testable without a mail server.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=true
# SMTP_USER=you@example.com
# SMTP_PASS=your-app-password
MAIL_FROM="WKSL <no-reply@your-domain.com>"

# ---- Optional integrations ----
# ANALYTICS_ENDPOINT=https://your-analytics-collector/collect
# ERROR_REPORT_ENDPOINT=https://your-collector/errors
# SECURITY_ALERT_WEBHOOK=https://hooks.slack.com/...

# ---- Google sign-in (optional) ----
# A "Web application" OAuth client from Google Cloud Console. Register this
# exact redirect URI there: <PUBLIC_URL>/api/auth/google/callback
# Leave both empty and the button never appears.
# GOOGLE_CLIENT_ID=000000000000-xxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxx
# Only needed when the address Google returns to differs from PUBLIC_URL.
# GOOGLE_OAUTH_REDIRECT=https://your-domain.com/api/auth/google/callback

# ---- Background jobs ----
ENABLE_JOBS=true
JOB_INTERVAL_MINUTES=15

# ---- Web push ----
# Generate a pair with: npx web-push generate-vapid-keys (keep it secret).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# ---- Uploads ----
UPLOAD_DIR=uploads
# Per-file cap for a single request. Files bigger than this ride the
# resumable chunked path below instead of one big request.
MAX_UPLOAD_MB=50
MAX_FILES_PER_UPLOAD=10
MAX_ATTACHMENTS_PER_POST=20
# Chunk size for large uploads (16 MB default, max 40) and the total size per
# file for the chunked path (1024 = 1 GB). 1 GB videos work without huge
# request bodies, so any proxy limit is irrelevant.
UPLOAD_CHUNK_MB=16
MAX_CHUNKED_UPLOAD_MB=1024
