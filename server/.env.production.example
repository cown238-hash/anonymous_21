# ---- Server ----
NODE_ENV=production
PORT=4000
CLIENT_ORIGINS=http://localhost:4000
PUBLIC_URL=http://localhost:4000
LOG_LEVEL=info
TRUST_PROXY=true

# ---- Database ----
# Production keeps its own database; `nimbus` is left for local testing.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/wksl_prod?schema=public"

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ---- Security policy ----
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCK_MINUTES=15
PASSWORD_RESET_TTL_MINUTES=60
EMAIL_VERIFY_TTL_HOURS=48
EMAIL_VERIFICATION_REQUIRED=true
TWO_FACTOR_ISSUER=WKSL

# Failed auth attempts per IP per window. Only failures count.
AUTH_LIMIT_MAX=20
AUTH_LIMIT_WINDOW_MINUTES=15

# ---- Email (SMTP) ----
# Leave unset locally: emails are printed to the log and their links returned
# by the API, so every flow stays testable without a mail server.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=true
# SMTP_USER=you@example.com
# SMTP_PASS=your-app-password
MAIL_FROM="WKSL <no-reply@your-domain.com>"

# ---- Optional integrations ----
# ANALYTICS_ENDPOINT=https://your-analytics-collector/collect
# ERROR_REPORT_ENDPOINT=https://your-collector/errors
# SECURITY_ALERT_WEBHOOK=https://hooks.slack.com/...

# ---- Background jobs ----
ENABLE_JOBS=true
JOB_INTERVAL_MINUTES=15

# ---- Uploads ----
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
MAX_FILES_PER_UPLOAD=10
MAX_ATTACHMENTS_PER_POST=20
