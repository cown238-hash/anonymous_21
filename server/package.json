{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force",
    "db:create": "node scripts/create-database.mjs",
    "db:apply": "node scripts/apply-migration.mjs",
    "db:columns": "node scripts/show-columns.mjs",
    "test:socket": "node scripts/socket-test.mjs",
    "test:upload": "node scripts/upload-test.mjs",
    "test:attachment": "node scripts/attachment-test.mjs",
    "test:slug": "node --experimental-strip-types scripts/slug-test.mjs",
    "test:totp": "tsx scripts/totp-test.mjs",
    "test:allowlist": "node scripts/allowlist-parity.mjs",
    "test:unit": "npm run test:allowlist && npm run test:slug && npm run test:totp",
    "test:privacy": "node scripts/privacy-test.mjs",
    "test:e2e": "node scripts/socket-test.mjs && node scripts/upload-test.mjs && node scripts/attachment-test.mjs && node scripts/privacy-test.mjs && node scripts/account-test.mjs",
    "test": "npm run test:unit && npm run test:e2e",
    "jobs": "tsx scripts/jobs.mjs",
    "jobs:prod": "node dist/services/jobs.js",
    "uploads:prune": "node scripts/prune-uploads-now.mjs",
    "test:account": "node scripts/account-test.mjs",
    "db:deploy": "prisma migrate deploy"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "@types/compression": "^1.7.5",
    "@types/nodemailer": "^6.4.17",
    "@types/qrcode": "^1.5.5",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "nodemailer": "^6.9.16",
    "otplib": "^12.0.1",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.5",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
