# ---- Server ----
NODE_ENV=development
PORT=4000
CLIENT_ORIGINS=http://localhost:5173
PUBLIC_URL=http://localhost:5173
LOG_LEVEL=info
# TRUST_PROXY=true

# ---- Database (local PostgreSQL) ----
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/nimbus?schema=public"

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters-long
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ---- Security policy ----
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCK_MINUTES=15
PASSWORD_RESET_TTL_MINUTES=60
EMAIL_VERIFY_TTL_HOURS=48
EMAIL_VERIFICATION_REQUIRED=false
TWO_FACTOR_ISSUER=WKSL

# Emit HSTS includeSubDomains + preload. Leave off unless the app is served at
# the apex of a domain: a subdomain cannot be preloaded, and includeSubDomains
# would only cover *.that-subdomain.
# HSTS_INCLUDE_SUBDOMAINS=true

# ---- Age gate ----
# Confirms a visitor is old enough before the content routes answer. Off here
# so local development and the e2e suite behave exactly as before; turn it on
# to work on the gate itself. The e2e scripts need it off (they read /api/posts
# before answering), so run them against a server started without this.
AGE_GATE_ENABLED=false
AGE_GATE_MIN_AGE=18
AGE_GATE_TTL_DAYS=365
# Recognise a returning visitor by a keyed hash of their address. Set to false
# to require a fresh answer on every new browser.
AGE_GATE_IP_BINDING=true

# Failed auth attempts allowed per IP per window. Only failures count.
# Raise this locally if you run the account test repeatedly — it fails three
# logins on purpose and the counters live in the server process.
AUTH_LIMIT_MAX=20
AUTH_LIMIT_WINDOW_MINUTES=15

# ---- Email (SMTP) ----
# Leave unset locally: emails are printed to the log and their links returned
# by the API, so every flow stays testable without a mail server.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@example.com
# SMTP_PASS=your-app-password
MAIL_FROM="WKSL <no-reply@nimbus.local>"

# ---- Optional integrations ----
# ANALYTICS_ENDPOINT=https://your-analytics-collector/collect
# ERROR_REPORT_ENDPOINT=https://your-collector/errors
# SECURITY_ALERT_WEBHOOK=https://hooks.slack.com/...

# ---- Google sign-in (optional) ----
# A "Web application" OAuth client from Google Cloud Console. Register this
# exact redirect URI there: <PUBLIC_URL>/api/auth/google/callback
# (http://localhost:5173/api/auth/google/callback while developing).
# Leave both empty and the button never appears.
# GOOGLE_CLIENT_ID=000000000000-xxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxx
# Only needed when the address Google returns to differs from PUBLIC_URL.
# GOOGLE_OAUTH_REDIRECT=http://localhost:4000/api/auth/google/callback

# ---- Background jobs ----
ENABLE_JOBS=false
JOB_INTERVAL_MINUTES=15

# ---- Uploads ----
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
MAX_FILES_PER_UPLOAD=10
MAX_ATTACHMENTS_PER_POST=20
